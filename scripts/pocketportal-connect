#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_directory="$(cd "$(dirname "$script_path")" && pwd)"
  script_target="$(readlink "$script_path")"
  if [[ "$script_target" == /* ]]; then
    script_path="$script_target"
  else
    script_path="$script_directory/$script_target"
  fi
done
package_root="$(cd "$(dirname "$script_path")/.." && pwd)"
launcher="$package_root/lib/connect-macos.sh"
engine="$package_root/libexec/pocketportal-connect-engine/bin/pocketportal-connect-engine"
device_picker="$package_root/lib/connect-device-picker.js"
release_parser="$package_root/lib/release-metadata.js"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/pocketportal"
client_config_file="$config_dir/connect-client.properties"
client_pid_file="$config_dir/connect.pid"
default_install_root="$HOME/.local/share/pocketportal-connect"
default_bin_dir="$HOME/.local/bin"
install_root="${POCKETPORTAL_CONNECT_INSTALL_ROOT:-$default_install_root}"
bin_dir="${POCKETPORTAL_CONNECT_BIN_DIR:-$default_bin_dir}"
release_api="${POCKETPORTAL_CONNECT_RELEASE_API:-https://api.github.com/repos/VanyaHuaman/PocketPortal-Connect/releases/latest}"
default_local_port=15556
shutdown_wait_attempts=30
shutdown_wait_seconds=0.1
update_root=""

cleanup_update() {
  [[ -z "$update_root" ]] || rm -rf "$update_root"
}

usage() {
  cat <<EOF
Usage:
  pocketportal-connect connect [launcher options]
  pocketportal-connect disconnect
  pocketportal-connect status
  pocketportal-connect update
  pocketportal-connect rollback VERSION
  pocketportal-connect version

Run 'pocketportal-connect connect --help' for connection options.
EOF
}

read_saved_setting() {
  local setting_name="$1"
  [[ -f "$client_config_file" ]] || return 0
  sed -n "s/^${setting_name}=//p" "$client_config_file" | tail -n 1
}

find_adb() {
  local candidate
  local candidates=()
  [[ -z "${POCKETPORTAL_CONNECT_ADB:-}" ]] ||
    candidates+=("$POCKETPORTAL_CONNECT_ADB")
  [[ -z "${ANDROID_SDK_ROOT:-}" ]] ||
    candidates+=("$ANDROID_SDK_ROOT/platform-tools/adb")
  [[ -z "${ANDROID_HOME:-}" ]] ||
    candidates+=("$ANDROID_HOME/platform-tools/adb")
  candidates+=(
    "$HOME/Library/Android/sdk/platform-tools/adb"
    "/Applications/Android Studio.app/Contents/sdk/platform-tools/adb"
  )
  if command -v adb >/dev/null 2>&1; then
    candidates+=("$(command -v adb)")
  fi
  for candidate in "${candidates[@]}"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

active_pid() {
  local pid
  [[ -f "$client_pid_file" ]] || return 1
  pid="$(sed -n '1p' "$client_pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  ps -p "$pid" -o command= 2>/dev/null |
    grep -q "pocketportal-connect-engine" || return 1
  printf '%s\n' "$pid"
}

link_release() {
  local version="$1"
  local release_command="$install_root/releases/$version/bin/pocketportal-connect"
  local command_path="$bin_dir/pocketportal-connect"
  local temporary_link="$bin_dir/.pocketportal-connect-link-$$"

  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || {
    echo "Invalid PocketPortal Connect version: $version" >&2
    return 1
  }
  [[ -x "$release_command" ]] || {
    echo "PocketPortal Connect $version is not installed." >&2
    return 1
  }
  [[ ! -e "$command_path" || -L "$command_path" ]] || {
    echo "Refusing to replace existing non-symlink: $command_path" >&2
    return 1
  }

  mkdir -p "$bin_dir"
  ln -s "$release_command" "$temporary_link"
  mv -f "$temporary_link" "$command_path"
}

update_client() {
  local metadata_file
  local archive_file
  local checksum_file
  local metadata_output
  local latest_version
  local archive_url
  local checksum_url
  local expected_checksum
  local actual_checksum
  local package_dir
  local current_version
  local metadata_lines=()

  command -v curl >/dev/null 2>&1 || {
    echo "curl is required to update PocketPortal Connect." >&2
    return 1
  }
  command -v osascript >/dev/null 2>&1 || {
    echo "osascript is required to update PocketPortal Connect." >&2
    return 1
  }
  command -v shasum >/dev/null 2>&1 || {
    echo "shasum is required to verify PocketPortal Connect." >&2
    return 1
  }
  command -v unzip >/dev/null 2>&1 || {
    echo "unzip is required to update PocketPortal Connect." >&2
    return 1
  }
  [[ -f "$release_parser" ]] || {
    echo "Release metadata parser is missing: $release_parser" >&2
    return 1
  }

  update_root="$(mktemp -d "${TMPDIR:-/tmp}/pocketportal-connect-update.XXXXXX")"
  trap cleanup_update EXIT
  metadata_file="$update_root/release.json"
  curl --fail --location --silent --show-error \
    "$release_api" --output "$metadata_file"
  metadata_output="$(osascript -l JavaScript "$release_parser" "$metadata_file")"
  while IFS= read -r line; do
    metadata_lines+=("$line")
  done <<<"$metadata_output"
  [[ "${#metadata_lines[@]}" -eq 3 ]] || {
    echo "GitHub release metadata is incomplete." >&2
    return 1
  }
  latest_version="${metadata_lines[0]}"
  archive_url="${metadata_lines[1]}"
  checksum_url="${metadata_lines[2]}"
  current_version="$(sed -n '1p' "$package_root/VERSION")"
  if [[ "$latest_version" == "$current_version" ]]; then
    echo "PocketPortal Connect $current_version is already current."
    return 0
  fi

  archive_file="$update_root/pocketportal-connect-$latest_version-macos.zip"
  checksum_file="$archive_file.sha256"
  curl --fail --location --silent --show-error \
    "$archive_url" --output "$archive_file"
  curl --fail --location --silent --show-error \
    "$checksum_url" --output "$checksum_file"
  expected_checksum="$(awk 'NR == 1 { print $1 }' "$checksum_file")"
  actual_checksum="$(shasum -a 256 "$archive_file" | awk '{ print $1 }')"
  [[ "$expected_checksum" =~ ^[0-9a-fA-F]{64}$ ]] || {
    echo "Published PocketPortal Connect checksum is invalid." >&2
    return 1
  }
  [[ "$actual_checksum" == "$expected_checksum" ]] || {
    echo "PocketPortal Connect checksum verification failed." >&2
    return 1
  }

  unzip -q "$archive_file" -d "$update_root/package"
  package_dir="$update_root/package/pocketportal-connect-$latest_version-macos"
  [[ -x "$package_dir/install.sh" ]] || {
    echo "Downloaded PocketPortal Connect package is incomplete." >&2
    return 1
  }
  "$package_dir/install.sh"
}

disconnect_local_adb() {
  local adb_path
  local local_port
  adb_path="$(find_adb || true)"
  local_port="$(read_saved_setting localPort)"
  [[ "$local_port" =~ ^[0-9]+$ ]] || local_port="$default_local_port"
  [[ -z "$adb_path" ]] ||
    "$adb_path" disconnect "127.0.0.1:$local_port" >/dev/null 2>&1 || true
}

command_name="${1:-connect}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  connect)
    export POCKETPORTAL_CONNECT_ENGINE="$engine"
    export POCKETPORTAL_CONNECT_DEVICE_PICKER="$device_picker"
    exec "$launcher" "$@"
    ;;
  disconnect)
    if pid="$(active_pid)"; then
      kill -INT "$pid"
      for ((attempt = 0; attempt < shutdown_wait_attempts; attempt++)); do
        kill -0 "$pid" 2>/dev/null || break
        sleep "$shutdown_wait_seconds"
      done
    fi
    disconnect_local_adb
    rm -f "$client_pid_file"
    echo "PocketPortal Connect is disconnected."
    ;;
  status)
    server="$(read_saved_setting server)"
    if pid="$(active_pid)"; then
      echo "PocketPortal Connect is connected."
      echo "Process: $pid"
    else
      echo "PocketPortal Connect is disconnected."
    fi
    [[ -z "$server" ]] || echo "Server: $server"
    ;;
  update)
    update_client
    ;;
  rollback)
    [[ $# -eq 1 ]] || {
      echo "Usage: pocketportal-connect rollback VERSION" >&2
      exit 2
    }
    link_release "$1"
    echo "PocketPortal Connect now uses version $1."
    ;;
  version)
    cat "$package_root/VERSION"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
